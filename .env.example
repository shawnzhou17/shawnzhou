# ─── Required ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Database (auto-configured in Docker; override for external DB) ──────────
DATABASE_URL=postgresql+asyncpg://askshawn:askshawn@db:5432/askshawn
SYNC_DATABASE_URL=postgresql://askshawn:askshawn@db:5432/askshawn

# ─── OpenAI Models ──────────────────────────────────────────────────────────
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval ───────────────────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=false
